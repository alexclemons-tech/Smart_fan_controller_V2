#include <WiFi.h>
#include <WebServer.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <Preferences.h>
#include <esp_task_wdt.h>

const char* AP_SSID = "FanControllerV2";
const int MIC_PIN = 2;
const int TEMP_PIN = 3;
const int FAN_MIN_RUN_SPEED = 170; // Change this number in the future to adjust your minimum speed floor
const int PWM_PIN = 4;

// NEW: Ground cut control pin (transistor/MOSFET gate/driver)
const int FAN_GND_CUT_PIN = 25;
const bool FAN_GND_ON = HIGH;   // Ground connected, fan electrically enabled
const bool FAN_GND_OFF = LOW;   // Ground disconnected, fan hard-off

const int PWM_FREQ = 25000;
const int PWM_RESOLUTION = 8;
const int PWM_MAX = 255;

WebServer server(80);
Preferences pref;
OneWire oneWire(TEMP_PIN);
DallasTemperature sensors(&oneWire);

struct FanState {
  int micLevel;
  float tempF;
  int fanDuty;
  bool autoMode;
  int manualSpeed;
  int micRawThreshold;
  int tempStart; 
  int tempMax;   
};

FanState state = {0, 0.0, 0, true, 128, 2000, 70, 105}; 

unsigned long lastSampleMs = 0;
const unsigned long SAMPLE_INTERVAL_MS = 1000;
unsigned long lastTimeNoisyMs = 0;
const unsigned long FAN_DELAY_MS = 5000;

// Kickstart tracking variables
unsigned long kickstartStartMs = 0;
bool isKickstarting = false;
int previousLoopDuty = 0;

