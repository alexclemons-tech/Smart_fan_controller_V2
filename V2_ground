int readAveragedAnalog(int pin) {
  unsigned long startMillis = millis();
  int signalMax = 0;
  int signalMin = 4095; // ESP32 Max ADC value

  // Sample the audio wave continuously for 50 milliseconds
  while (millis() - startMillis < 50) {
    int sample = analogRead(pin);
    
    // Prevent sampling errors from breaking the math
    if (sample < 4096) {
      if (sample > signalMax) {
        signalMax = sample; // Save the highest peak
      }
      if (sample < signalMin) {
        signalMin = sample; // Save the lowest valley
      }
    }
  }

  // Peak-to-Peak Amplitude = Total sound volume height
  int peakToPeak = signalMax - signalMin; 
  return peakToPeak;
}

void updateControlLoop() {
  state.micLevel = readAveragedAnalog(MIC_PIN);
  keepAlive();
  sensors.requestTemperatures();
  keepAlive();
  
  float currentTempF = sensors.getTempFByIndex(0);
  if (currentTempF > -100.0 && currentTempF < 250.0) {
    state.tempF = currentTempF;
  }

  int targetDuty = 0;
  if (state.autoMode) {
    bool isNoisy = (state.micLevel > state.micRawThreshold);
    bool isOverheated = (state.tempF >= state.tempMax);

    if (isNoisy) {
      lastTimeNoisyMs = millis();
    }
    
    // 1. FIRST RULE: If someone is talking (or it was recently noisy) AND it's NOT dangerously hot, turn the fan off.
    if (isNoisy && !isOverheated) {
      targetDuty = 0;
    } 
    else if ((millis() - lastTimeNoisyMs < FAN_DELAY_MS) && !isOverheated) {
      targetDuty = 0;
    } 
    // 2. SECOND RULE: If someone is talking but it IS overheated, lock the fan to exactly 170 for heat safety.
    else if (isOverheated && (isNoisy || (millis() - lastTimeNoisyMs < FAN_DELAY_MS))) {
      targetDuty = 170; 
    }
    // 3. THIRD RULE: If it is totally quiet, let the fan scale naturally all the way up to full blast (255).
    else {
      targetDuty = map(constrain((int)state.tempF, state.tempStart, state.tempMax), state.tempStart, state.tempMax, 0, PWM_MAX);
      
      // Keep the floor at 170 so it never dips low enough to stall out while scaling up
      if (targetDuty > 0 && targetDuty < 170) {
        targetDuty = 170; 
      }
    }
  } else {
    targetDuty = state.manualSpeed;
  }

  // --- NON-BLOCKING KICKSTART ENGINE ---
  
  // Detect if the fan needs to wake up from an absolute stop
  if (previousLoopDuty == 0 && targetDuty > 0 && !isKickstarting) {
    isKickstarting = true;
    kickstartStartMs = millis();
  }

  // Manage active kickstart duration
  if (isKickstarting) {
    if (millis() - kickstartStartMs < 350) {
      state.fanDuty = PWM_MAX; // Force 100% duty cycle to get blades rotating
    } else {
      isKickstarting = false; // Kickstart window closed
      state.fanDuty = constrain(targetDuty, 0, PWM_MAX);
    }
  } else {
    state.fanDuty = constrain(targetDuty, 0, PWM_MAX);
  }

  // Record requested goal duty for tracking changes in next cycle
  previousLoopDuty = targetDuty;

  // NEW: Hard off via ground cut when duty is 0
  bool shouldEnableFanGround = (state.fanDuty > 0);

  if (!shouldEnableFanGround) {
    // Force true electrical off
    analogWrite(PWM_PIN, 0);
    digitalWrite(FAN_GND_CUT_PIN, FAN_GND_OFF);
    isKickstarting = false; // optional cleanup for next restart
  } else {
    // Ensure ground path is active before driving PWM
    digitalWrite(FAN_GND_CUT_PIN, FAN_GND_ON);
    analogWrite(PWM_PIN, state.fanDuty);
  }
}

void keepAlive() {
  server.handleClient();
  esp_task_wdt_reset();
  delay(1);
}

void handleRoot() {
  server.send(200, "text/html", renderPage());
}

void handleToggleMode() {
  state.autoMode = !state.autoMode;
  pref.begin("fan_ctrl", false);
  pref.putBool("auto", state.autoMode);
  pref.end();
  server.send(200, "text/plain", "OK");
}

void handleSetParam() {
  bool updated = false;
  pref.begin("fan_ctrl", false);
  if (server.hasArg("speed")) {
    state.manualSpeed = server.arg("speed").toInt();
    pref.putInt("speed", state.manualSpeed);
    updated = true;
  }
  if (server.hasArg("sens")) {
    state.micRawThreshold = server.arg("sens").toInt();
    pref.putInt("sens_raw", state.micRawThreshold);
    updated = true;
  }
  if (server.hasArg("tStart")) {
    state.tempStart = server.arg("tStart").toInt();
    pref.putInt("tStart_raw", state.tempStart);
    updated = true;
  }
  if (server.hasArg("tMax")) {
    state.tempMax = server.arg("tMax").toInt();
    pref.putInt("tMax_raw", state.tempMax);
    updated = true;
  }
  pref.end();
  server.send(200, "text/plain", "OK");

  // Keep responsive if manually updating slider or thresholds
  if (!state.autoMode && server.hasArg("speed")) {
    // Let the central control loop process manual updates so kickstart applies to sliders too
    updateControlLoop(); 
  }
}

void handleStatus() {
  String json = "{";
  json += "\"micLevel\":" + String(state.micLevel) + ",";
  json += "\"savedThresh\":" + String(state.micRawThreshold) + ",";
  json += "\"tempF\":" + String(state.tempF, 2) + ",";
  json += "\"fanDuty\":" + String(state.fanDuty) + ",";
  json += "\"autoMode\":" + String(state.autoMode ? "true" : "false");
  json += "}";
  server.send(200, "application/json", json);
}

void setup() {
  Serial.begin(115200);

  pinMode(MIC_PIN, INPUT);
  pinMode(PWM_PIN, OUTPUT);

  // NEW: initialize ground-cut output in fail-safe OFF
  pinMode(FAN_GND_CUT_PIN, OUTPUT);
  digitalWrite(FAN_GND_CUT_PIN, FAN_GND_OFF);
  delay(50);

  analogWriteResolution(PWM_PIN, PWM_RESOLUTION);
  analogWriteFrequency(PWM_PIN, PWM_FREQ);
  analogWrite(PWM_PIN, 0);
  sensors.begin();

  pref.begin("fan_ctrl", true);
  state.autoMode = pref.getBool("auto", true);
  state.manualSpeed = pref.getInt("speed", 128);
  state.micRawThreshold = pref.getInt("sens_raw", 2000);
  state.tempStart = pref.getInt("tStart_raw", 70);
  state.tempMax = pref.getInt("tMax_raw", 105);
  pref.end();

  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID);
  WiFi.setTxPower(WIFI_POWER_5dBm);

  server.on("/", handleRoot);
  server.on("/toggle", handleToggleMode);
  server.on("/setParam", handleSetParam);
  server.on("/status", handleStatus);
  server.begin();

  esp_task_wdt_config_t twdt_config = {
    .timeout_ms = 5000,
    .idle_core_mask = (1 << portNUM_PROCESSORS) - 1,
    .trigger_panic = true
  };

  esp_task_wdt_init(&twdt_config);
  esp_task_wdt_add(NULL);
}

void loop() {
  keepAlive();
  // Continuously run kickstart check if active, or poll normally on sample interval
  if (isKickstarting || (millis() - lastSampleMs >= SAMPLE_INTERVAL_MS)) {
    if (!isKickstarting) {
      lastSampleMs = millis();
    }
    updateControlLoop();
  }
}
